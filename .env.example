# Data source, fixed per build (FI1-Q2). `backend` runs against the real backend; anything else
# (or unset) is the mock demo. `npm run dev:backend` / `npm run build:backend` set it for you.
VITE_DATA_SOURCE="mock"

# Development only: where the Vite dev server forwards `/api`. The browser's Host header is kept,
# because the backend resolves the tenant from it.
BACKEND_ORIGIN="http://127.0.0.1:8000"

# Development only: host names the dev server answers to (Vite's DNS-rebinding check).
# A leading dot allows every subdomain. Give development tenants a `<tenant>.localhost` domain and
# open the app there, for example http://acme.localhost:3000. Browsers resolve `*.localhost` to the
# loopback address (no hosts-file entry) and treat it as a secure context over plain HTTP, which the
# cross-tab refresh lock needs. A plain-HTTP name such as `acme.internal` is not a secure context:
# several tabs refreshing at once can then end the session (FI1-A-F3).
FRONTEND_ALLOWED_HOSTS=".localhost"
